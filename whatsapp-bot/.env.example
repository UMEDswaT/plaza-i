# Copy to .env; NEVER commit this file or send its contents in chat.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Default paid OpenAI Responses API; optional freellmapi is DEMO only.
AI_PROVIDER=openai
# FreeLLMAPI is a self-hosted local router, not a public hosted API.
# Use only for synthetic testing with DEMO_MODE=1, AI_PREVIEW_MODE=1.
# It does not work at localhost on Render if running on your own computer.
FREELLMAPI_BASE_URL=http://127.0.0.1:3001/v1
FREELLMAPI_API_KEY=
FREELLMAPI_MODEL=auto
META_ACCESS_TOKEN=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PHONE_NUMBER_ID=
META_GRAPH_VERSION=v25.0
ADMIN_USERNAME=plazai
ADMIN_PASSWORD=
DATABASE_PATH=/app/data/plazai.sqlite3
# Set to 1 ONLY for local dry-run demos; does not send WhatsApp messages.
DEMO_MODE=0
# Optional real AI in the protected dashboard, without sending WhatsApp messages.
# Requires OPENAI_API_KEY and can incur API charges. Keep DEMO_MODE=1.
AI_PREVIEW_MODE=0
# Your domain WITHOUT https://, required for the optional Caddy setup.
DOMAIN=
