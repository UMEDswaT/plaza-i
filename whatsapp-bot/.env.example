# Copy to .env; NEVER commit this file or send its contents in chat.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
META_ACCESS_TOKEN=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PHONE_NUMBER_ID=
META_GRAPH_VERSION=v25.0
ADMIN_USERNAME=plazai
ADMIN_PASSWORD=
DATABASE_PATH=/app/data/plazai.sqlite3
# Set to 1 ONLY for local dry-run demos; does not send WhatsApp messages.
DEMO_MODE=0
# Optional real AI in the protected dashboard, without sending WhatsApp messages.
# Requires OPENAI_API_KEY and can incur API charges. Keep DEMO_MODE=1.
AI_PREVIEW_MODE=0
# Your domain WITHOUT https://, required for the optional Caddy setup.
DOMAIN=
